# 앱(Expo) 환경변수 예시. app/.env 로 복사해서 씁니다. app/.env 는 git에 올리지 않습니다.
#   자동(저장소 루트에서): Windows  powershell -ExecutionPolicy Bypass -File scripts\setup.ps1
#                          macOS    bash scripts/setup.sh
#   직접 복사:             Copy-Item app\.env.example app\.env   또는   cp app/.env.example app/.env
#
# 주의: EXPO_PUBLIC_* 값은 앱 번들(JS)에 그대로 들어가 누구나 꺼내 볼 수 있습니다.
#       GEMINI_API_KEY, LAW_API_OC 같은 비밀 값은 여기에 넣지 말고 server/.env 에만 둡니다.
# 값을 바꾼 뒤에는 Expo를 멈추고 `npx expo start --clear` 로 다시 시작해야 반영됩니다.

# true: 서버 API를 호출합니다. false(또는 app/.env 없음): 서버 없이 앱 안의 로컬 데모로 동작합니다.
EXPO_PUBLIC_USE_API=true

# 상담 API 서버 주소. 끝에 / 를 붙이지 않습니다. setup 스크립트는 app/.env 에서 이 줄만 바꿉니다.
#   - 실기기(휴대폰 Expo Go): PC의 Wi-Fi/이더넷 IPv4. 예) http://192.168.0.23:8000
#     휴대폰에서 localhost 는 PC가 아니라 휴대폰 자신입니다. PC와 같은 Wi-Fi에 연결하세요.
#   - Android 에뮬레이터: http://10.0.2.2:8000 (에뮬레이터 안에서 본 PC의 localhost)
#   - iOS 시뮬레이터(macOS): http://127.0.0.1:8000
#   - 터널 HTTPS 주소도 됩니다(같은 Wi-Fi에서 안 붙을 때).
#     cloudflared tunnel --url http://localhost:8000 이 알려 주는 https://<임의 이름>.trycloudflare.com
#   - 다른 팀원 PC의 서버를 쓸 때: 그 PC의 IPv4. 예) http://192.168.0.31:8000
EXPO_PUBLIC_API_URL=http://192.168.0.10:8000
