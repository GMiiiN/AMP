# 실제 값은 .env 파일에 넣고, .env는 커밋하지 않습니다.

# demo: 외부 호출 없이 입력 내용만 정리 / rag: 판례 검색 + Gemini 생성
CONSULTATION_MODE=demo

# --- Gemini (rag 모드에서 사용. 비워 두면 검색 결과만 반환) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# 무료 한도가 부족하면 Flash-Lite 계열 모델 ID로 바꿉니다 (보고서 14장 2번).
# 기타 분야 웹 검색(Google Search grounding) 전용 모델. 무료 등급 grounding은 2.5 계열만 가능(하루 500건).
# 2.5 모델은 예전에 써 본 계정에만 열려 있어 403/404가 나면 일반 답변으로 대체됩니다.
GEMINI_SEARCH_MODEL=gemini-2.5-flash-lite
# 웹 검색이 이 시간(ms) 안에 끝나지 않으면 일반 답변으로 대체합니다(앱 요청 제한 60초).
GEMINI_SEARCH_TIMEOUT_MS=15000
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT_MS=45000
GEMINI_RETRY_DELAY_SECONDS=1

# --- 판례 검색 ---
VECTOR_DB_PATH=data/vector_db/precedents.sqlite3
TFIDF_MIN_SCORE=0.12
# 임시값입니다. 임베딩 색인을 만든 뒤 시험 질의로 측정해 확정합니다 (보고서 14장 6번).
EMBEDDING_MIN_SCORE=0.60

# --- 기타 ---
CORS_ORIGINS=http://localhost:8081
# 국가법령정보 공동활용 인증값 (data/scripts/collect.py)
LAW_API_OC=
